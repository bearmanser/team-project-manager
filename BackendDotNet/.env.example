DEBUG=True
SECRET_KEY=replace_with_the_same_secret_key_used_by_the_django_backend
SQLITE_PATH=../Backend/db.sqlite3
FRONTEND_URL=http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
ACCESS_TOKEN_ROTATION_LEEWAY_SECONDS=300
AUTH_ACCESS_COOKIE_NAME=team_project_manager_access
AUTH_REFRESH_COOKIE_NAME=team_project_manager_refresh
AUTH_COOKIE_PATH=/api/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Strict
PROJECT_EVENTS_RETRY_MS=2000
PROJECT_EVENTS_POLL_INTERVAL_SECONDS=1.5
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/oauth/github/callback
